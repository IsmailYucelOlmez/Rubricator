{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flutter-web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "build/web",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8765
    },
    {
      "name": "static-site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--directory",
        "site/dist",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8766
    },
    {
      "name": "virgil-mock-backend",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "run",
        "--allow-net",
        "--allow-env",
        "site/tools/mock_backend.ts"
      ],
      "port": 8767
    }
  ]
}