        <item name="windowSplashScreenBackground">#F7F7F7</item>
        <item name="android:windowSplashScreenBackground">#F7F7F7</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_android12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo_android12</item>
        <item name="windowSplashScreenIconBackgroundColor">#F7F7F7</item>
