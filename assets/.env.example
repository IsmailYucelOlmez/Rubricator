# Optional local fallback for `flutter run` without --dart-define-from-file.
# Copy to assets/.env and fill in (assets/.env is gitignored).
# CI/release builds use --dart-define-from-file=env.production.json instead.
#
# SEMANTIC_API_KEY / SEMANTIC_API_BASE_URL (or RUBRICATOR_*/API_*) are
# Supabase Edge Function secrets for `rubricatorApi`, not client env vars.
API_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SENTRY_DSN=
